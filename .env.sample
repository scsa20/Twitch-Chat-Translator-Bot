# Example environment variables for Twitch Chat Translator Bot

# Bot identity
BOT_USERNAME=your_bot_username
CHANNEL_NAME=your_channel_or_comma_separated_list

# Twitch auth: either provide a token or enable the OAuth flow
# Example token format: oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWITCH_OAUTH=
#TWITCH_OAUTH_FLOW=false
#TWITCH_CLIENT_ID=your_twitch_client_id
#TWITCH_CLIENT_SECRET=your_twitch_client_secret
#TWITCH_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
#TWITCH_OAUTH_CERT_PATH=
#TWITCH_OAUTH_KEY_PATH=

# Optional: 64 hex chars used to encrypt stored OAuth tokens (recommended in prod)
ENCRYPTION_KEY=

# Azure Translator
AZURE_SUB_KEY=

# Languages (ISO 639-1 or Azure format)
PRIMARY_LANG=en
SECONDARY_LANG=
# Per-channel language overrides: PRIMARY_LANG_<CHANNEL> and SECONDARY_LANG_<CHANNEL>

# Additional optional settings
